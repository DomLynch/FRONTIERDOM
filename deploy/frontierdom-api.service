# Install only after database decision and accepted candidate.
[Unit]
Description=FRONTIERDOM authoritative API
After=network.target

[Service]
Type=simple
User=frontierdom
Group=frontierdom
WorkingDirectory=/var/www/frontierdom/current
Environment=HOST=127.0.0.1
Environment=PORT=3097
Environment=NODE_ENV=production
Environment=TRUST_PROXY=1
EnvironmentFile=/etc/frontierdom/api.env
ExecStart=/usr/bin/node /var/www/frontierdom/current/server/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
