# Proposed Node entrypoint; Lead/Backend must confirm before installation.
[Unit]
Description=FRONTIERDOM authoritative API
After=network.target

[Service]
Type=simple
User=frontierdom
Group=frontierdom
WorkingDirectory=/var/www/frontierdom/current
Environment=HOST=127.0.0.1
Environment=PORT=3097
Environment=FD_DATA_DIR=/srv/frontierdom/shared
EnvironmentFile=-/etc/frontierdom/api.env
ExecStart=/usr/bin/node /var/www/frontierdom/current/server/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/frontierdom/shared
UMask=0077

[Install]
WantedBy=multi-user.target
